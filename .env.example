# Stripe (test or live). Checkout works with only the secret key —
# products are created inline via price_data unless you set price IDs.
# Enable "Stablecoins and Crypto" in the Stripe Dashboard payment methods
# so the USDC checkout rail can run. Recurring crypto is not on this account.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional. If omitted, Checkout uses price_data ($29 Pro / $149 Agency).
# Existing price IDs must match those amounts or checkout will disagree with the page.
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PRO_YEAR=price_...
STRIPE_PRICE_STUDIO=price_...
STRIPE_PRICE_STUDIO_YEAR=price_...

# Used to sign the entitlement cookie. Falls back to STRIPE_SECRET_KEY.
BILLING_SECRET=change-me

# Public checkout only when live Stripe is on, or this is 1.
# BILLING_OPEN=1

# Legal/contact placeholder. Do not commit a personal inbox.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@outrank.coach

# Public origin for success/cancel/portal return URLs.
NEXT_PUBLIC_APP_URL=https://outrank.coach

# Allow the local "unlock without Stripe" button even in production.
# ALLOW_DEV_BILLING=1

# Locks /app/curate in production. Local dev is open if unset.
# CURATOR_KEY=pick-a-long-secret

# Optional. Conversational coach on /app/coach. Without it, replies
# come from the Strategic Profile and the local instrument.
# XAI_API_KEY=xai-...

# Algo-change email. Without RESEND_API_KEY the list still saves locally
# and the watch will not send. Verify the from-domain in Resend.
# RESEND_API_KEY=re_...
# ALERT_FROM=OUTRANK <alerts@outrank.coach>
# CRON_SECRET=long-random
# GitHub Action must send: Authorization: Bearer $CRON_SECRET
# Vercel Cron sends CRON_SECRET automatically when that env is set.
