# Stripe (test or live). Checkout works with only the secret key —
# products are created inline via price_data unless you set price IDs.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional. If omitted, Checkout uses price_data ($19 Pro / $49 Studio).
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_STUDIO=price_...

# Used to sign the entitlement cookie. Falls back to STRIPE_SECRET_KEY.
BILLING_SECRET=change-me

# Public origin for success/cancel/portal return URLs.
NEXT_PUBLIC_APP_URL=https://outrank.coach

# Allow the local "unlock without Stripe" button even in production.
# ALLOW_DEV_BILLING=1
