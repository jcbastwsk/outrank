{
  "manifest_version": 3,
  "name": "Outrank — X algorithm coach",
  "version": "0.1.4",
  "description": "Live reach coach on x.com, scored against the published For You weights.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Outrank",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://penguin.linux.test:3000/*",
    "https://outrank.coach/*",
    "https://www.outrank.coach/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outrank.coach/*",
        "https://www.outrank.coach/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://penguin.linux.test:3000/*"
      ],
      "js": ["site.js"],
      "run_at": "document_idle"
    }
  ]
}
